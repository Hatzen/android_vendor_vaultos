<resources>
    <!-- Automatically enable CustomOtterControl ShiftKeyService on first boot -->
    <string name="def_accessibility_services" translatable="false">
        de.hartz.software.customottercontrol/de.hartz.software.customottercontrol.ShiftKeyService
    </string>
    <integer name="def_accessibility_enabled">1</integer>

    <!-- Concept 006: Enable native Android 16 One-Handed Mode by default -->
    <integer name="def_one_handed_mode_enabled">1</integer>

    <!-- ADR 006: Internal GNSS is hardware-disabled with the modem (Location OFF) -->
    <integer name="def_location_mode">0</integer>
</resources>

